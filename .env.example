# LOCAL DEVELOPMENT ONLY. Copy to .env, replace all change-me values, never commit .env.
# Generate random credentials: openssl rand -hex 32
COMPOSE_PROJECT_NAME=zaakiy-bi
TZ=Asia/Dubai
N8N_PORT=5678
S3_PORT=8333
API_PORT=3000
POSTGRES_PASSWORD=change-me-strong-postgres-superuser-password
APP_DB_PASSWORD=change-me-strong-app-role-password
N8N_DB_PASSWORD=change-me-strong-n8n-db-password
N8N_ENCRYPTION_KEY=change-me-long-random-encryption-key
N8N_RUNNERS_AUTH_TOKEN=change-me-long-random-runner-token
S3_ACCESS_KEY=zaakiy-local
S3_SECRET_KEY=change-me-long-random-s3-secret
SEAWEEDFS_ADMIN_PASSWORD=change-me-long-random-admin-password
INTERNAL_API_TOKEN=change-me-long-random-internal-token

# Optional app layer: these images do NOT exist in this repository yet.
ZAAKIY_API_IMAGE=zaakiy-api:local
ZAAKIY_AGENT_IMAGE=zaakiy-agent:local
ZAAKIY_WORKER_IMAGE=zaakiy-worker:local

# External Azure services; only required when future app images exist.
AZURE_FOUNDRY_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_FOUNDRY_API_KEY=change-me-azure-key
AZURE_FOUNDRY_CHAT_DEPLOYMENT=gpt-5.4-deployment-name
AZURE_FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-large-deployment-name
DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-document-intelligence.cognitiveservices.azure.com
DOCUMENT_INTELLIGENCE_KEY=change-me-document-intelligence-key
